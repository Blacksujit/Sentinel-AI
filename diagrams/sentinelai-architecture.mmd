        SETTINGS["🔧 /settings<br/>(Org/Workspace)"]
        WORKSPACES["🏢 /workspaces<br/>(CRUD)"]
        INTEL["🧠 /intel<br/>(Incidents/Deployments)"]
        REDTEAM["🎯 /redteam<br/>(Adversarial Testing)"]
