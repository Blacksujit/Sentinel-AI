# SentinelAI Environment Configuration
# Copy this file to .env and update with your actual values

# Environment
ENVIRONMENT=development  # Change to 'production' for production

# API Configuration
SENTINELAI_API_KEYS=dev-key-12345,prod-key-67890,test-key-11111  # Comma-separated API keys
API_BASE_URL=http://localhost:8000  # Change to your production URL

# Database Configuration
DATABASE_URL=sqlite:///./sentinel_ai.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Optional: External API Rate Limiting
EXTERNAL_API_RATE_LIMIT=100  # Requests per minute per API key
