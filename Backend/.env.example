# ── SentinelAI Environment Configuration ──────────────────────────
# Copy this to .env and fill in your values.
# docker compose will read from .env automatically.

# ── Application ───────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=1.0.0
SERVICE_NAME=sentinelai-api
LOG_LEVEL=INFO
LOG_FORMAT=json
UVICORN_WORKERS=2

# ── Database ────────────────────────────────────────────────────
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/sentinelai
# SQLite (development):
# DATABASE_URL=sqlite:///./sentinel_ai.db
DATABASE_URL=postgresql://sentinelai_user:password@sentinelai-db:5432/sentinelai
ALLOW_SQLITE_FALLBACK=false

# ── Auth (Clerk) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── API Keys ─────────────────────────────────────────────────────
SENTINELAI_API_KEYS=

# ── Email (Mailpit for dev) ──────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
FROM_EMAIL=noreply@sentinelai.com
FRONTEND_BASE_URL=http://localhost:3000
DEBUG_ADMIN_TOKEN=debug-token-example

# ── Ports ─────────────────────────────────────────────────────────
API_PORT=8000
DB_PORT=5432
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
