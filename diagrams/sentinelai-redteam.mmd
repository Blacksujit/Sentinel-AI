        VERIFICATION["✅ Verification<br/>(Multi-method)"]
        SCORING["📊 Scoring<br/>(Pass/Fail + Confidence)"]
    end
    
    subgraph VERIFICATION_METHODS["✅ Verification Methods"]
        KEYWORD_MATCH["🔍 Keyword Match<br/>(Forbidden phrases)"]
