graph TD
    %% ============================================
    %% SentinelAI Platform Architecture
    %% ============================================
    
    %% ----- EXTERNAL CLIENTS -----
    subgraph EXTERNAL["🌐 External Clients"]
        PLAYGROUND["🎮 Web Playground<br/>(React/Next.js)"]
        EXT_API["🔌 External API Consumers<br/>(API Keys \ JWT)"]
        WEBHOOKS["📬 Webhook Senders<br/>(Clerk, Stripe, GitHub)"]
        CLI_SDK["📦 sentinelai-sdk<br/>(Python/TypeScript)"]
    end
    
    %% ----- EDGE + INGRESS -----
    subgraph EDGE["🛡️ Edge & Ingress"]
        CDN["☁️ CDN \ Vercel Edge<br/>(Global Distribution)"]
        LB["⚖️ Load Balancer<br/>(Vercel \ AWS ALB)"]
        WAF["🛡️ WAF \ Rate Limiter<br/>(DDoS Protection)"]
    end
    
    %% ----- API GATEWAY -----
    subgraph GATEWAY["🚪 API Gateway (FastAPI)"]
        MW_STACK["📦 Middleware Stack"]
        ROUTER["🗂️ Router Registry"]
    end
    
    subgraph MIDDLEWARE["⚙️ Middleware Pipeline"]
