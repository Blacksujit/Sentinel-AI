    VERIFICATION_METHODS --> SCORING
    SCORING --> REPORTING
    
    REPORTING --> RUN_REPORT
    REPORTING --> FINDINGS_DB
    REPORTING --> TREND_ANALYSIS
    REPORTING --> COMPLIANCE
    
    REPORTING --> INTEGRATIONS
    API_ROUTES --> EXECUTOR
    GITHUB_ACTIONS --> SCHEDULER
    SLACK_ALERTS --> FINDINGS_DB
    JIRA --> FINDINGS_DB
    GITBOOK --> REPORTING
    
    %% Budget Guard
    BUDGET_GUARD -.-> EXECUTOR
    BUDGET_GUARD -.-> CASE_GEN
    BUDGET_GUARD -.-> PROMPT_EXEC
    
    %% Mutation Flow
    MUTATION_ENGINE -.-> ATTACK_CLASSES
    MUTATION_ENGINE -.-> CASE_GEN
    
