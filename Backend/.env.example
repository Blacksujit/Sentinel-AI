# Environment
ENVIRONMENT=development
# Set to production on Render. Use ALLOW_SQLITE_FALLBACK=false in production.

# Database — REQUIRED on Render (use Internal Database URL from Render Postgres dashboard)
# DATABASE_URL=postgresql://user:pass@hostname:5432/dbname
DATABASE_URL=sqlite:///./sentinel_ai.db

# Clerk JWT verification (optional in dev — unsigned decode fallback)
# CLERK_JWT_KEY=

# API keys for external /analyze (comma-separated)
# SENTINELAI_API_KEYS=

# Do not commit auth_debug.txt or other local debug artifacts
