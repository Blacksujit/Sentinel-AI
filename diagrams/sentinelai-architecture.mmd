        METRICS_MW["📊 MetricsMiddleware<br/>(Prometheus)"]
        SYS_METRICS["💻 SystemMetricsCollector<br/>(CPU/Memory)"]
    end
    
    %% ----- CORE API LAYER -----
    subgraph API["🎯 Core API Layer"]
        ROUTES["📍 Route Modules"]
    end
    
    subgraph ROUTE_MODULES["📂 Route Modules"]
