    end
    
    subgraph INTEGRATIONS["🔗 Integrations"]
        API_ROUTES["🌐 API Routes<br/>(REST + Webhooks)"]
        GITHUB_ACTIONS["🔄 CI/CD Integration<br/>(Nightly runs)"]
