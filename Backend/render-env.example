# Render Environment Variables Example
# Copy this to .env.render and update with your values

# Environment
ENVIRONMENT=production
PYTHON_VERSION=3.11.5

# Database (if using Render PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# API Configuration
SENTINELAI_API_KEYS=your-api-key-here,another-key-here
API_KEY_HEADER=X-API-Key

# SMTP email delivery — works with Mailpit (dev), SendGrid, Mailgun, Resend, etc.
# For local dev: docker-compose up mailpit (SMTP on port 1025, UI at http://localhost:8025)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@sentinelai.com

# Frontend URL used to build invite links
FRONTEND_BASE_URL=https://your-frontend-domain.com

# DEBUG_ADMIN_TOKEN is required for the protected test email endpoint.
DEBUG_ADMIN_TOKEN=debug-token-example

# Frontend URL used to build invite links
FRONTEND_BASE_URL=https://your-frontend-domain.com

# CORS Settings
ALLOWED_ORIGINS=https://sentinel-ai-hazel.vercel.app/

# Logging
LOG_LEVEL=INFO
