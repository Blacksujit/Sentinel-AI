        WEBHOOKS_R["📬 /webhooks<br/>(Clerk/Stripe)"]
        REDTEAM_R["🎯 /redteam<br/>(Runs/Reports)"]
        HEALTH["💚 /health /metrics<br/>(Observability)"]
    end
    
    %% ----- BUSINESS LOGIC + SERVICES -----
    subgraph SERVICES["⚙️ Business Logic \ Services"]
        SIGNAL_REG["📡 Signal Registry<br/>(Detectors)"]
        RISK_REASONER["🧠 RiskReasoner<br/>(Aggregation)"]
        POLICY_ENGINE["⚖️ PolicyEngine<br/>(Decisions)"]
