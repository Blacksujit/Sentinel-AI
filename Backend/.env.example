# Environment
ENVIRONMENT=development

# Database
# Local: SQLite is fine
DATABASE_URL=sqlite:///./sentinel_ai.db

# Render: use Internal Database URL from Render Postgres (NOT a placeholder host)
# DATABASE_URL=postgresql://user:pass@dpg-xxxxx-a.oregon-postgres.render.com/sentinel_ai

# If Postgres is misconfigured, API can start with SQLite when true (ephemeral on Render free tier)
ALLOW_SQLITE_FALLBACK=true

# Clerk JWT verification (optional — PEM public key from Clerk Dashboard → API keys)
# Do NOT set this to CLERK_SECRET_KEY (sk_...). Leave unset to decode session JWTs without verify.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# API keys for external /analyze (comma-separated)
# SENTINELAI_API_KEYS=

# Do not commit auth_debug.txt or other local debug artifacts
