# ── SentinelAI Environment Configuration ──────────────────────────
# Copy this to .env and fill in your values.
# docker compose will read from .env automatically.

# ── Application ───────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=1.0.0
SERVICE_NAME=sentinelai-api
LOG_LEVEL=INFO
LOG_FORMAT=json
UVICORN_WORKERS=2

# ── Database ────────────────────────────────────────────────────
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/sentinelai
# SQLite (development):
# DATABASE_URL=sqlite:///./sentinel_ai.db
DATABASE_URL=postgresql://sentinelai_user:password@sentinelai-db:5432/sentinelai
ALLOW_SQLITE_FALLBACK=false

# ── Auth (Clerk) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# JWT Public Key (PEM) from Clerk Dashboard → API Keys → JWT Public Key
# REQUIRED in production for JWT verification. In development, JWT verification
# is skipped when ENVIRONMENT=development and this key is not set.
# On Render: set as a single line with literal \n for newlines.
CLERK_JWT_PUBLIC_KEY=

# ── CORS (production) ─────────────────────────────────────────────
# Comma-separated list of allowed origins. Set this on Render to the Vercel
# frontend URL, e.g. https://sentinel-ai-hazel.vercel.app
CORS_ALLOW_ORIGINS=https://sentinel-ai-hazel.vercel.app

# ── API Keys ─────────────────────────────────────────────────────
SENTINELAI_API_KEYS=

# ── Email (Mailpit for dev) ──────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
FROM_EMAIL=noreply@sentinelai.com
FRONTEND_BASE_URL=http://localhost:3000
DEBUG_ADMIN_TOKEN=debug-token-example

# ── Ports ─────────────────────────────────────────────────────────
API_PORT=8000
DB_PORT=5432
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Stripe (Billing) ──────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_xxxxxx_pro
# STRIPE_PRICE_TEAM=price_xxxxxx_team
# STRIPE_PRICE_ENTERPRISE=price_xxxxxx_enterprise

# ── Redis (Rate Limiting & Queue) ─────────────────────────────────
# REDIS_URL=redis://redis:6379/0
