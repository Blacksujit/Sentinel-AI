        BUDGET_GUARD["💰 Budget Guard<br/>(Token/Time/Cost Limits)"]
        MUTATION_ENGINE["🧬 Mutation Engine<br/>(Evolutionary)"]
    end
    
    subgraph ATTACK_CLASSES["🎯 Attack Classes (12)"]
        INSTRUCTION_OVERRIDE["📝 Instruction Override<br/>(Ignore previous instructions)"]
